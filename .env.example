NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://localhost:5500
SERVE_FRONTEND=false
# Transactions require a replica set (the supplied Compose file creates one).
MONGODB_URI=mongodb://127.0.0.1:27017/secure_notes?replicaSet=rs0&directConnection=true
# Generate: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_TTL_SECONDS=900
BCRYPT_ROUNDS=12
# Only set to the exact number of trusted reverse proxies in front of Express.
TRUST_PROXY_HOPS=0
API_RATE_LIMIT=300
AUTH_RATE_LIMIT=20
QUERY_TIMEOUT_MS=10000
# Development only: creates declared indexes before accepting requests.
# In production set false and run npm run db:indexes before deployment.
AUTO_INDEX=true
# Used only by npm run create-admin; remove the password after bootstrapping.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Administrator
